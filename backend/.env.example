# Copy to .env and fill in. .env is git-ignored.

# PostgreSQL connection string.
#   Local dev (Docker):  postgresql://curbi:curbi@localhost:5432/curbi
#   Deployment:          the hosted AWS RDS endpoint, e.g.
#     postgresql://curbi:<password>@curbi-db.abc1234.ap-southeast-2.rds.amazonaws.com:5432/curbi
DATABASE_URL=postgresql://curbi:curbi@localhost:5432/curbi

# Optional: AIHW catalog endpoint for the Epic 4 snapshot auto-refresh. Left
# blank the backend just serves the committed data/aihw_snapshot.json.
AIHW_CATALOG_URL=
