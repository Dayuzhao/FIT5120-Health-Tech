# Copy to .env and fill in. .env is git-ignored.

# Jamendo API client_id — a public app identifier (not a secret), but kept out
# of the repo for the same reason DATABASE_URL is: config, not code. Get one
# free at https://devportal.jamendo.com/ (Register application, plan "Read
# only"). Used by build-jamendo.js (Epic 6 / US6).
JAMENDO_CLIENT_ID=
